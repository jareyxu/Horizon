[Unit]
Description=Horizon daily AI digest
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=7200
StartLimitBurst=2

[Service]
Type=oneshot
User=horizon
Group=horizon
WorkingDirectory=/opt/horizon/app
EnvironmentFile=/etc/horizon/horizon.env
Environment=HOME=/opt/horizon
ExecStart=/bin/bash /opt/horizon/app/scripts/vps-daily-run.sh
TimeoutStartSec=3600
Restart=on-failure
RestartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/horizon
MemoryMax=650M

