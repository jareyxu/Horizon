{
  "version": "1.0",
  "report_timezone": "UTC",
  "profile": {
    "editorial_mode": "creator",
    "interests": [
      "面向普通人的 AI 新功能与工具",
      "办公、学习和生活中的实用 AI 用法",
      "AI 生图、视频、声音与创作玩法",
      "有趣且可核实的 AI 新闻",
      "AI 对个人工作和生活的影响",
      "适合抖音、小红书、视频号的选题"
    ],
    "negative_topics": [
      "纯工程架构、推理部署和底层优化",
      "只有跑分或参数的论文和模型发布",
      "开发库、Kubernetes 和 GitHub 常规版本更新",
      "无事实依据的夸大营销与收益承诺",
      "纯融资新闻",
      "与 AI 无关的娱乐八卦"
    ],
    "preferred_content": [
      "能亲自演示的教程与效果对比",
      "普通人可以实际使用的新功能",
      "有画面感和新奇感的真实案例",
      "有事实依据的趋势解读和个人观点",
      "包含价格、地区开放与使用限制的信息"
    ]
  },
  "verification": {
    "enabled": false,
    "top_n": 5,
    "aihot_min_score": 75,
    "max_excerpt_chars": 4000,
    "concurrency": 3
  },
  "ai": {
    "provider": "openai",
    "model": "gpt-4",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "xxx@qq.com",
